rules_version = '2';
// Roles come from custom claims set by api/scripts/seed.ts: { role, agencyId }.
service cloud.firestore {
  match /databases/{database}/documents {
    function role() { return request.auth != null ? request.auth.token.role : null; }
    function isCoordinator() { return role() == 'coordinator'; }
    function isAgency() { return role() == 'agency'; }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /reports/{id} {
      // Reporters may be anonymous during the demo. TODO: require anonymous auth + rate limit.
      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.aiStatus == 'pending';
      allow update: if isCoordinator()
        || (resource.data.aiStatus == 'pending' && onlyChanges(['aiStatus', 'extraction']));
      allow read: if isCoordinator();
    }

    match /incidents/{id} {
      function hasAssignment() {
        return exists(/databases/$(database)/documents/assignments/$(id + '_' + request.auth.token.agencyId));
      }
      allow create: if request.resource.data.status == 'reported';
      allow update: if isCoordinator()
        // the reporter's phone saves what the AI understood and its GPS location
        || (resource.data.status == 'reported' && onlyChanges([
          'incidentType', 'building', 'floor', 'landmark', 'peopleReported', 'summary', 'location', 'updatedAt']))
        // a late GPS ("Try again") may still arrive after the coordinator verified
        || (resource.data.status in ['verified', 'response'] && onlyChanges(['location', 'updatedAt']))
        // an agency that was asked for help taps "On the way"
        || (isAgency() && hasAssignment()
          && resource.data.status in ['verified', 'response']
          && request.resource.data.status == 'response'
          && onlyChanges(['status', 'respondingKinds', 'updatedAt']));
      // Reading one incident by id is open: the id is a long random code that only the
      // reporter's phone (and assigned agencies) know. Listing all incidents is coordinator-only.
      allow get: if true;
      allow list: if isCoordinator();

      match /events/{eventId} {
        allow read: if isCoordinator() || isAgency();
        allow create: if request.resource.data.incidentId == id;
      }
    }

    match /agencies/{id} {
      allow read: if request.auth != null;
      allow update: if isCoordinator() || (isAgency() && request.auth.token.agencyId == id);
    }

    match /assignments/{id} {
      allow create: if isCoordinator();
      allow read: if isCoordinator() || (isAgency() && resource.data.agencyId == request.auth.token.agencyId);
      allow update: if isCoordinator()
        || (isAgency() && resource.data.agencyId == request.auth.token.agencyId && onlyChanges(['status', 'updatedAt']));
    }
  }
}
