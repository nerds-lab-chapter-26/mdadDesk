# Firebase console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise SITE key (public) for App Check, needed for AI. docs/firebase-setup.md step 9
VITE_RECAPTCHA_SITE_KEY=
# Phone number that receives SOS by SMS when the reporter has no internet (coordinator). Optional.
# The SMS does not reach the Desk. Empty = the SMS app opens and the reporter picks who to send it to.
VITE_SOS_SMS_NUMBER=
